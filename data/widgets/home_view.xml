<gui>
  <vbox noborders="true" id="home_view" border="4" childspacing="2" expansive="true">

    <hbox noborders="true" id="header_placeholder">
      <link id="aseprite_face" style="aseprite_face" />
      <vbox border="4" childspacing="4">
        <link id="new_file" text="@.new_file" style="workspace_link" />
        <link id="open_file" text="@.open_file" style="workspace_link" />
        <link id="recover_sprites" text="@.recover_files" style="workspace_link"
              tooltip="@.recover_files_tooltip" />
      </vbox>
      <boxfiller />
      <vbox border="4">
        <check id="share_crashdb" text="@.share_crashdb"
               tooltip="@.share_crashdb_tooltip" style="workspace_check_box" />
      </vbox>
    </hbox>
    <splitter horizontal="true" noborders="true" childspacing="2"
              expansive="true" by="percentage" position="72" style="workspace_splitter">
        <vbox id="files_placeholder" childspacing="4">
          <label id="recent_files_label" text="@home_view.recent_previews" style="workspace_label" />
          <view id="files_view" expansive="true" style="recent_previews_view" />
        </vbox>
        <splitter id="folders_placeholder" vertical="true" noborders="true" childspacing="6"
                  by="percentage" position="43" style="workspace_splitter">
          <vbox childspacing="4">
            <label id="recent_folders_label" text="@home_view.recent_folders" style="workspace_label" />
            <view id="folders_view" expansive="true" style="workspace_view" />
          </vbox>
          <vbox childspacing="4">
            <label id="recent_list_label" text="@home_view.recent_files" style="workspace_label" />
            <view id="recent_list_view" expansive="true" style="workspace_view" />
          </vbox>
        </splitter>
    </splitter>
  </vbox>
</gui>
